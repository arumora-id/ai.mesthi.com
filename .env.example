# Demo is self-contained. API mode uses the verified C4 endpoints.
VITE_DATA_MODE=demo

# Same-origin reverse proxy/BFF to the Mesthi API. Never put secrets in VITE_ variables.
VITE_API_BASE_URL=/api

# Production authentication is owned by auth.mesthi.com.
# session = browser uses HttpOnly session through the ai.mesthi.com gateway/BFF.
# bearer = temporary operator integration only; never use for public production login.
VITE_AUTH_MODE=session
VITE_AUTH_BASE_URL=https://auth.mesthi.com
