# Copy to deploy/secrets/oauth2-proxy.cfg. This file then contains secrets; never commit it.
provider = "oidc"
oidc_issuer_url = "https://CHANGE_ME_ISSUER"
client_id = "CHANGE_ME_CLIENT_ID"
client_secret = "CHANGE_ME_CLIENT_SECRET"
redirect_url = "https://ai.mesthi.com/oauth2/callback"
email_domains = ["CHANGE_ME_ALLOWED_EMAIL_DOMAIN"]
scope = "openid profile email offline_access"
code_challenge_method = "S256"
http_address = "0.0.0.0:4180"
upstreams = ["static://202"]
reverse_proxy = true
set_xauthrequest = true
pass_access_token = true
pass_authorization_header = false
set_authorization_header = false
skip_provider_button = true
cookie_name = "__Host-mesthi_session"
cookie_secret = "CHANGE_ME_RANDOM_32_BYTE_BASE64"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_path = "/"
cookie_expire = "8h"
cookie_refresh = "5m"
cookie_csrf_per_request = true
session_store_type = "redis"
redis_connection_url = "redis://redis:6379/0"
redis_password = "CHANGE_ME_REDIS_PASSWORD"
request_logging = false
auth_logging = true
standard_logging = true
