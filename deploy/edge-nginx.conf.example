# Add inside the existing HTTPS server for ai.mesthi.com after DNS and TLS are configured.
# That nginx container must join MESTHI_EDGE_NETWORK. Do not expose port 8080 publicly.
location / {
    proxy_pass http://mesthi-frontend:8080;
    proxy_set_header Host ai.mesthi.com;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host ai.mesthi.com;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_next_upstream off;
    proxy_read_timeout 35s;
}
add_header Strict-Transport-Security "max-age=31536000" always;
